{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "fortigate-external-dns values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "duration": {
      "allOf": [
        {
          "type": "string",
          "pattern": "^([0-9]+(ns|us|µs|ms|s|m|h))+$"
        },
        {
          "not": {
            "pattern": "^(0+(ns|us|µs|ms|s|m|h))+$"
          }
        }
      ]
    },
    "durationOrEmpty": {
      "type": "string",
      "pattern": "^$|^([0-9]+(ns|us|µs|ms|s|m|h))+$"
    },
    "cidrOrEmpty": {
      "type": "string",
      "pattern": "^$|^[0-9a-fA-F.:]+/[0-9]{1,3}$"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    }
  },
  "properties": {
    "global": { "type": "object" },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[0-9a-f]{64}$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["service", "ingress", "gateway"] }
    },
    "namespaces": { "type": "array", "items": { "type": "string" } },
    "gatewayTargetNamespaces": { "type": "array", "items": { "type": "string" } },
    "domainFilters": { "type": "array", "items": { "type": "string" } },
    "ownerID": { "type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[^;=]+$" },
    "defaultTTL": { "type": "integer", "minimum": 1, "maximum": 604800 },
    "dryRun": { "type": "boolean" },
    "once": { "type": "boolean" },
    "interval": { "$ref": "#/definitions/duration" },
    "reconcileTimeout": { "$ref": "#/definitions/duration" },
    "cleanupPolicy": { "type": "string", "enum": ["delete", "deactivate", "keep"] },
    "allowEmptyDesiredCleanup": { "type": "boolean" },
    "maxCleanupPerCycle": { "type": "integer", "minimum": 0 },
    "logFormat": { "type": "string", "enum": ["text", "json"] },
    "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
    "healthzMaxStaleness": { "$ref": "#/definitions/durationOrEmpty" },
    "leaderElection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "id": { "type": "string" },
        "namespace": { "type": "string" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "$ref": "#/definitions/port" },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "annotations": { "type": "object" }
          }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "allowedNamespaces": { "type": "array", "items": { "type": "object" } }
          }
        }
      }
    },
    "fortigate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string" },
        "zone": { "type": "string" },
        "vdom": { "type": "string" },
        "existingSecret": { "type": "string" },
        "apiTokenSecretKey": { "type": "string", "minLength": 1 },
        "exclusiveZoneOwnership": { "type": "boolean" },
        "insecureSkipVerify": { "type": "boolean" },
        "caBundle": { "type": "string" },
        "timeout": { "$ref": "#/definitions/duration" },
        "retries": { "type": "integer", "minimum": 0, "maximum": 10 }
      }
    },
    "egressNetworkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "fortigate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidr": { "$ref": "#/definitions/cidrOrEmpty" },
            "port": { "$ref": "#/definitions/port" }
          }
        },
        "kubeAPI": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidr": { "$ref": "#/definitions/cidrOrEmpty" },
            "ports": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/port" }
            }
          }
        },
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "cidr": { "$ref": "#/definitions/cidrOrEmpty" }
          }
        }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "resources": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "securityContext": { "type": "object" },
    "podSecurityContext": { "type": "object" }
  }
}
